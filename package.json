{
  "name": "dsh-preset-codex",
  "version": "0.1.0",
  "description": "在真实仓库里长期作业的编码模式：先读代码再动手，改根因不绕症状，改动小而准。适合多文件修改、缺陷排查和代码审查。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "agent-preset",
    "codex",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test",
    "prepublishOnly": "node scripts/build.mjs --check && node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
