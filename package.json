{
  "name": "dsh-preset-codex",
  "version": "0.2.0",
  "description": "在真实仓库里长期作业的编码模式：先读代码再动手，改根因不绕症状，改动小而准。适合多文件修改、缺陷排查和代码审查。",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SquirrelJimmy/dsh-preset-codex.git"
  },
  "homepage": "https://github.com/SquirrelJimmy/dsh-preset-codex#readme",
  "bugs": {
    "url": "https://github.com/SquirrelJimmy/dsh-preset-codex/issues"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "agent-preset",
    "codex",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./plugins/*.js": "./plugins/*.js"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "plugins/*.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "upstream:check": "node scripts/sync-upstream.mjs",
    "upstream:sync": "node scripts/sync-upstream.mjs --write",
    "test": "node --test",
    "prepublishOnly": "node scripts/build.mjs --check && node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
